+        expected,
+        local_endpoint("http://127.0.0.1:1/v1/", true).request_identity()
+    );
+    assert_ne!(
+        expected,
+        local_endpoint("http://127.0.0.1:1/other/v1", true).request_identity()
+    );
+    assert_ne!(
+        expected,
+        local_endpoint("http://127.0.0.1:1/v1", false).request_identity()
+    );
+    let mut changed = local_endpoint("http://127.0.0.1:1/v1", true);
+    changed.choice.name = "New label".into();
+    assert_eq!(expected, changed.request_identity());
+    changed.choice.model = "other-model".into();
+    assert_ne!(expected, changed.request_identity());
+    let mut changed = local_endpoint("http://127.0.0.1:1/v1", true);
+    changed.choice.provider = "other-provider".into();
+    assert_ne!(expected, changed.request_identity());
+}
