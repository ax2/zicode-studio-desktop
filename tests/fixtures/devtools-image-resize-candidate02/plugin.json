{
  "schemaVersion": 2,
  "id": "com.zicode.devtools.image",
  "name": "ZiDevTools Image Resize",
  "displayName": "ZiDevTools 图片缩放",
  "description": "对用户明确选择的一张 PNG、JPEG 或 WebP 图片进行有界缩放并生成派生图片。",
  "version": "0.1.1",
  "publisher": "zicode",
  "license": "MIT",
  "engines": {
    "zicode": ">=0.1.0 <1.0.0",
    "pluginApi": "^1.0.0"
  },
  "requiredProfiles": {
    "resource.wasi.image.resize.v1": "=1.0.0-preview.1",
    "output.schema.v1": "=1.0.0-rc.1",
    "resource.output.types.v1": "=1.0.0-preview.1"
  },
  "activationEvents": [
    "onCapability:devtools.image.resize"
  ],
  "runtime": {
    "wasi": "runtime/tools.wasm",
    "resourceInputProfile": "resource.wasi.input.draft2",
    "resourceOutputProfile": "resource.wasi.output.draft1"
  },
  "contributes": {
    "activities": [],
    "views": [],
    "capabilities": [
      {
        "id": "devtools.image.resize",
        "title": "缩放图片",
        "description": "只处理当前调用中用户确认提供的单张图片，不访问路径或网络。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "maxWidth": {
              "type": "string",
              "title": "最大宽度（像素）",
              "default": "1600",
              "minLength": 1,
              "maxLength": 4
            },
            "format": {
              "type": "string",
              "title": "输出格式",
              "enum": ["png", "jpeg", "webp"],
              "default": "webp"
            },
            "quality": {
              "type": "string",
              "title": "JPEG质量（35–95；仅JPEG生效）",
              "default": "82",
              "minLength": 2,
              "maxLength": 2
            }
          },
          "required": ["maxWidth", "format", "quality"],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "ok": {"type": "boolean", "const": true},
            "sourceWidth": {"type": "integer", "minimum": 1, "maximum": 4096},
            "sourceHeight": {"type": "integer", "minimum": 1, "maximum": 4096},
            "width": {"type": "integer", "minimum": 1, "maximum": 4096},
            "height": {"type": "integer", "minimum": 1, "maximum": 4096},
            "mimeType": {"type": "string", "enum": ["image/png", "image/jpeg", "image/webp"]},
            "byteLength": {"type": "integer", "minimum": 1, "maximum": 33554432}
          },
          "required": ["ok", "sourceWidth", "sourceHeight", "width", "height", "mimeType", "byteLength"],
          "additionalProperties": false
        },
        "maxResultBytes": 1024,
        "executionProfile": "resource.wasi.image.resize.v1"
      }
    ],
    "commands": [],
    "piTools": []
  },
  "permissions": {
    "required": [
      {
        "name": "resource.read",
        "reason": "每次调用都需要用户明确选择并授权一张图片，只读取该资源的有界快照。"
      }
    ],
    "optional": []
  }
}
