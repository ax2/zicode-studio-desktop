            },
            "right": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "required": [
            "left",
            "right"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "devtools_compare_json_diff_unordered",
        "title": "JSON 对比（数组忽略顺序）",
