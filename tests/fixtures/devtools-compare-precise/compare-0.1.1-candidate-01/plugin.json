          ],
          "additionalProperties": false
        }
      },
      {
        "name": "devtools_compare_regex_matches",
        "title": "正则表达式匹配",
        "description": "正则表达式匹配 on explicitly provided bounded text.",
        "capability": "devtools.compare.regex.matches",
        "inputSchema": {
          "type": "object",
          "properties": {
