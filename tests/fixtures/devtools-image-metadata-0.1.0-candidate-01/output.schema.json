{
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "operation": {
          "type": "string",
          "enum": [
            "inspect",
            "clean"
          ]
        },
        "report": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "integer",
              "const": 2
            },
            "material": {
              "type": "string",
              "const": "image-metadata-report"
            },
            "generatedBy": {
              "type": "object",
              "properties": {
                "toolId": {
                  "type": "string",
                  "const": "image-metadata"
                },
                "toolVersion": {
                  "type": "string",
                  "maxLength": 32
                },
                "runtimeFingerprint": {
                  "type": "object",
                  "properties": {
                    "schema": {
                      "type": "integer",
                      "const": 1
                    },
                    "appVersion": {
                      "type": "string",
                      "maxLength": 32
                    },
                    "os": {
                      "type": "string",
                      "maxLength": 32
                    },
                    "architecture": {
                      "type": "string",
                      "maxLength": 32
                    },
                    "buildProfile": {
                      "type": "string",
                      "enum": [
                        "debug",
                        "release"
                      ]
                    },
                    "sha256": {
                      "type": "string",
                      "minLength": 64,
                      "maxLength": 64
                    }
                  },
                  "required": [
                    "schema",
                    "appVersion",
                    "os",
                    "architecture",
                    "buildProfile",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "toolId",
                "toolVersion",
                "runtimeFingerprint"
              ],
              "additionalProperties": false
            },
            "origin": {
              "type": "object",
              "properties": {
                "toolId": {
                  "type": "string",
                  "const": "image-metadata"
                },
                "version": {
                  "type": "string",
                  "maxLength": 32
                },
                "utc": {
                  "type": "string",
                  "maxLength": 32
                }
              },
              "required": [
                "toolId",
                "version",
                "utc"
              ],
              "additionalProperties": false
            },
            "source": {
              "type": "object",
              "properties": {
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 33554432
                },
                "displayWidth": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12000
                },
                "displayHeight": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12000
                },
                "metadata": {
                  "type": "object",
                  "properties": {
                    "format": {
                      "type": "string",
                      "enum": [
                        "PNG",
                        "JPEG",
                        "WebP"
                      ]
                    },
                    "exif": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "hasExifGpsDirectory": {
                      "type": "boolean"
                    },
                    "icc": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "xmp": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "text": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "iptc": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "other": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "animation": {
                      "type": "boolean",
                      "const": false
                    },
                    "hasRecognizedMetadata": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "format",
                    "exif",
                    "hasExifGpsDirectory",
                    "icc",
                    "xmp",
                    "text",
                    "iptc",
                    "other",
                    "animation",
                    "hasRecognizedMetadata"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "bytes",
                "displayWidth",
                "displayHeight",
                "metadata"
              ],
              "additionalProperties": false
            },
            "cleanedPreview": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "bytes": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 134217728
                    },
                    "metadata": {
                      "type": "object",
                      "properties": {
                        "format": {
                          "type": "string",
                          "enum": [
                            "PNG",
                            "JPEG",
                            "WebP"
                          ]
                        },
                        "exif": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295
                        },
                        "hasExifGpsDirectory": {
                          "type": "boolean"
                        },
                        "icc": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295
                        },
                        "xmp": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295
                        },
                        "text": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295
                        },
                        "iptc": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295
                        },
                        "other": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295
                        },
                        "animation": {
                          "type": "boolean",
                          "const": false
                        },
                        "hasRecognizedMetadata": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "format",
                        "exif",
                        "hasExifGpsDirectory",
                        "icc",
                        "xmp",
                        "text",
                        "iptc",
                        "other",
                        "animation",
                        "hasRecognizedMetadata"
                      ],
                      "additionalProperties": false
                    },
                    "jpegQuality": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "integer",
                          "minimum": 35,
                          "maximum": 95
                        }
                      ]
                    },
                    "kind": {
                      "type": "string",
                      "const": "encoded-preview"
                    },
                    "saved": {
                      "type": "null"
                    }
                  },
                  "required": [
                    "bytes",
                    "metadata",
                    "jpegQuality",
                    "kind",
                    "saved"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "notes": {
              "type": "string",
              "maxLength": 1024
            }
          },
          "required": [
            "schemaVersion",
            "material",
            "generatedBy",
            "origin",
            "source",
            "cleanedPreview",
            "notes"
          ],
          "additionalProperties": false
        },
        "previewIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "ok",
        "operation",
        "report",
        "previewIndex"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "IMAGE_METADATA_FAILED"
            },
            "message": {
              "type": "string",
              "maxLength": 512
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
