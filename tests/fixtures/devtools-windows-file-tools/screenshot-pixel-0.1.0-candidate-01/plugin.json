{
  "schemaVersion": 2,
  "id": "com.zicode.devtools.screenshot-pixel",
  "name": "ZiDevTools PNG Screenshot Pixel",
  "displayName": "PNG 截图取色",
  "description": "读取已确认的本机静态 PNG 的一个原始像素，可复制 RGB、Alpha 和十六进制色值。",
  "version": "0.1.0",
  "publisher": "zicode",
  "license": "MIT",
  "engines": {
    "zicode": ">=0.7.2 <1.0.0",
    "pluginApi": "^1.0.0"
  },
  "requiredProfiles": {
    "resource.input.types.v1": "=1.0.0-preview.1",
    "tool.directory.v1": "=1.0.0-preview.1",
    "output.schema.v1": "=1.0.0-rc.1"
  },
  "activationEvents": [
    "onCapability:devtools.screenshot.png.pixel"
  ],
  "runtime": {
    "wasi": "runtime/tools.wasm",
    "resourceInputProfile": "resource.wasi.input.draft2"
  },
  "contributes": {
    "activities": [],
    "views": [],
    "commands": [],
    "piTools": [],
    "capabilities": [
      {
        "id": "devtools.screenshot.png.pixel",
        "title": "PNG 截图取色",
        "description": "读取已确认的本机静态 PNG 的一个原始像素，可复制 RGB、Alpha 和十六进制色值。",
        "resourceInputMimeTypes": [
          "image/png"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 511,
              "title": "原图 X 坐标",
              "description": "从左侧 0 起算的列。"
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 511,
              "title": "原图 Y 坐标",
              "description": "从顶部 0 起算的行。"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 511
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 511
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 512
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 512
                    },
                    "rgba": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      }
                    },
                    "hexRgb": {
                      "type": "string",
                      "maxLength": 7
                    },
                    "hexRgba": {
                      "type": "string",
                      "maxLength": 9
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 512
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height",
                    "rgba",
                    "hexRgb",
                    "hexRgba",
                    "text"
                  ],
                  "additionalProperties": false
                },
                "error": {
                  "type": "null"
                }
              },
              "required": [
                "ok",
                "data",
                "error"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "boolean",
                  "const": false
                },
                "data": {
                  "type": "null"
                },
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "message": {
                      "type": "string",
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "ok",
                "data",
                "error"
              ],
              "additionalProperties": false
            }
          ]
        },
        "maxResultBytes": 4096,
        "directory": {
          "categoryId": "files",
          "aliases": [
            "截图取色",
            "原像素色值",
            "PNG Pixel Color"
          ],
          "description": "读取已确认的本机静态 PNG 的一个原始像素，可复制 RGB、Alpha 和十六进制色值。"
        }
      }
    ]
  },
  "permissions": {
    "required": [
      {
        "name": "resource.read",
        "reason": "只读取本次明确确认的一张截图文件。"
      }
    ],
    "optional": []
  }
}
