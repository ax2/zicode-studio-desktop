{
  "schemaVersion": 2,
  "id": "com.zicode.devtools.table-pipeline",
  "name": "ZiDevTools Confirmed Table Pipeline",
  "displayName": "运行表格管线并保存 CSV",
  "description": "选择 JSON 管线配方和 CSV、TSV 或 JSON 表格，按文件列表的顺序指定配方位置。确认共享并运行，再确认保存带公式保护的新 CSV。",
  "version": "0.1.0",
  "publisher": "zicode",
  "license": "MIT",
  "engines": {
    "zicode": ">=0.7.2 <1.0.0",
    "pluginApi": "^1.0.0"
  },
  "requiredProfiles": {
    "resource.input.types.v1": "=1.0.0-preview.1",
    "resource.output.types.v1": "=1.0.0-preview.1",
    "tool.directory.v1": "=1.0.0-preview.1",
    "output.schema.v1": "=1.0.0-rc.1"
  },
  "activationEvents": [
    "onCapability:devtools.table.pipeline.replay"
  ],
  "runtime": {
    "wasi": "runtime/tools.wasm",
    "resourceInputProfile": "resource.wasi.input.draft2",
    "resourceOutputProfile": "resource.wasi.output.draft1"
  },
  "contributes": {
    "activities": [],
    "views": [],
    "commands": [],
    "piTools": [],
    "capabilities": [
      {
        "id": "devtools.table.pipeline.replay",
        "title": "运行表格管线并保存 CSV",
        "description": "选择 JSON 管线配方和 CSV、TSV 或 JSON 表格，按文件列表的顺序指定配方位置。确认共享并运行，再确认保存带公式保护的新 CSV。",
        "resourceInputMax": 2,
        "resourceInputMimeTypes": [
          "application/octet-stream",
          "text/plain",
          "text/csv"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "enum": [
                "csv",
                "tsv",
                "json"
              ],
              "title": "数据文件的表格格式",
              "description": "选择 CSV、TSV 或 JSON。留空使用 CSV。"
            },
            "recipePosition": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2,
              "title": "配方在文件列表的位置",
              "description": "填写 1 或 2。留空使用列表第一份。"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "maxLength": 512
                    },
                    "steps": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 32
                    },
                    "rowsBefore": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 96
                    },
                    "rowsAfter": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 96
                    },
                    "columns": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 16
                    },
                    "csvBytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32768
                    },
                    "formulaProtection": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "text",
                    "steps",
                    "rowsBefore",
                    "rowsAfter",
                    "columns",
                    "csvBytes",
                    "formulaProtection"
                  ],
                  "additionalProperties": false
                },
                "error": {
                  "type": "null"
                }
              },
              "required": [
                "ok",
                "data",
                "error"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "boolean",
                  "const": false
                },
                "data": {
                  "type": "null"
                },
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "message": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "step": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 32
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "ok",
                "data",
                "error"
              ],
              "additionalProperties": false
            }
          ]
        },
        "maxResultBytes": 8192,
        "directory": {
          "categoryId": "files",
          "aliases": [
            "可组合数据管线",
            "表格流水线",
            "Table Pipeline"
          ],
          "description": "选择 JSON 管线配方和 CSV、TSV 或 JSON 表格，按文件列表的顺序指定配方位置。确认共享并运行，再确认保存带公式保护的新 CSV。"
        }
      }
    ]
  },
  "permissions": {
    "required": [
      {
        "name": "resource.read",
        "reason": "只读取本次明确确认的两份文件，按填写的位置区分配方和表格。"
      }
    ],
    "optional": []
  }
}
