              "description": "例如 C:\\ZiDevTools\\ZiDevToolsMcp.exe。请输入已知且信任的本机路径。"
            }
          },
          "required": [
            "executablePath"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "contractVersion": {
                  "type": "string",
                  "const": "1.0.0-rc.1"
                },
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "format": {
                      "type": "string",
                      "const": "json"
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  },
                  "required": [
                    "format",
                    "text"
                  ],
                  "additionalProperties": false
                },
                "error": {
                  "type": "null"
                }
              },
              "required": [
                "contractVersion",
                "ok",
                "data",
                "error"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "contractVersion": {
                  "type": "string",
                  "const": "1.0.0-rc.1"
                },
                "ok": {
                  "type": "boolean",
                  "const": false
                },
                "data": {
                  "type": "null"
                },
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "message": {
                      "type": "string",
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "contractVersion",
                "ok",
                "data",
                "error"
              ],
              "additionalProperties": false
            }
          ]
        },
        "maxResultBytes": 8192,
        "directory": {
          "categoryId": "text",
          "aliases": [
            "MCP 通用配置",
            "Generic MCP configuration"
          ],
          "description": "预览通用 mcpServers JSON 的 stdio 字段。可确认保存为 Studio 产物。"
        }
      }
    ]
  },
  "permissions": {
    "required": [],
    "optional": []
  }
}
