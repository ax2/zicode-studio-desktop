{
  "schemaVersion": 2,
  "id": "com.zicode.devtools.mcp-client-export",
  "name": "ZiDevTools MCP Client Config Preview",
  "displayName": "MCP 客户端配置预览",
  "description": "手动输入已知 MCP 程序路径，预览与复制客户端配置。",
  "version": "0.1.0",
  "publisher": "zicode",
  "license": "MIT",
  "engines": {
    "zicode": ">=0.7.2 <1.0.0",
    "pluginApi": "^1.0.0"
  },
  "requiredProfiles": {
    "compute.wasi.v1": "=1.0.0-rc.1",
    "output.schema.v1": "=1.0.0-rc.1",
    "tool.directory.v1": "=1.0.0-preview.1"
  },
  "activationEvents": [
    "onCapability:devtools.mcp.config.codex-toml",
    "onCapability:devtools.mcp.config.generic-json"
  ],
  "runtime": {
    "wasi": "runtime/tools.wasm"
  },
  "contributes": {
    "activities": [],
    "views": [],
    "commands": [],
    "piTools": [],
    "capabilities": [
      {
        "id": "devtools.mcp.config.codex-toml",
        "title": "MCP 配置 · Codex TOML",
        "description": "预览 Codex TOML，仅启用两个知识工具并保留写入审批。可确认保存为 Studio 产物。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "executablePath": {
              "type": "string",
              "maxLength": 1024,
              "minLength": 1,
              "title": "MCP 服务程序绝对路径",
              "description": "例如 C:\\ZiDevTools\\ZiDevToolsMcp.exe。请输入已知且信任的本机路径。"
            }
          },
          "required": [
            "executablePath"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "contractVersion": {
                  "type": "string",
                  "const": "1.0.0-rc.1"
                },
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "format": {
                      "type": "string",
                      "const": "toml"
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  },
                  "required": [
                    "format",
                    "text"
                  ],
                  "additionalProperties": false
                },
                "error": {
                  "type": "null"
                }
              },
              "required": [
                "contractVersion",
                "ok",
                "data",
                "error"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "contractVersion": {
                  "type": "string",
                  "const": "1.0.0-rc.1"
                },
                "ok": {
                  "type": "boolean",
                  "const": false
                },
                "data": {
                  "type": "null"
                },
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "message": {
                      "type": "string",
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "contractVersion",
                "ok",
                "data",
                "error"
              ],
              "additionalProperties": false
            }
          ]
        },
        "maxResultBytes": 8192,
        "directory": {
          "categoryId": "text",
          "aliases": [
            "MCP Codex 配置",
            "Codex MCP config"
          ],
          "description": "预览 Codex TOML，仅启用两个知识工具并保留写入审批。可确认保存为 Studio 产物。"
        }
      },
      {
        "id": "devtools.mcp.config.generic-json",
        "title": "MCP 配置 · 通用 JSON",
        "description": "预览通用 mcpServers JSON 的 stdio 字段。可确认保存为 Studio 产物。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "executablePath": {
              "type": "string",
              "maxLength": 1024,
              "minLength": 1,
