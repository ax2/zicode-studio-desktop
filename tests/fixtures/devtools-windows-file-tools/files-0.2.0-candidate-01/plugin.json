{
  "schemaVersion": 2,
  "id": "com.zicode.devtools.files",
  "name": "ZiDevTools File Integrity",
  "displayName": "ZiDevTools 文件校验",
  "description": "对明确授权的文件快照计算 SHA-256 和 SHA-512；不修改原文件。",
  "version": "0.2.0",
  "publisher": "zicode",
  "license": "MIT",
  "engines": {
    "zicode": ">=0.4.2 <1.0.0",
    "pluginApi": "^1.0.0"
  },
  "requiredProfiles": {
    "resource.wasi.file-digest.v1": "=1.0.0-preview.1",
    "resource.input.types.v1": "=1.0.0-preview.1",
    "output.schema.v1": "=1.0.0-rc.1",
    "tool.directory.v1": "=1.0.0-preview.1",
    "resource.wasi.file-digest-stream.v1": "=1.0.0-preview.1"
  },
  "activationEvents": [
    "onCapability:devtools.files.hash"
  ],
  "runtime": {
    "wasi": "runtime/tools.wasm",
    "resourceInputProfile": "resource.wasi.input.draft2",
    "resourceOutputProfile": "resource.wasi.output.draft1"
  },
  "contributes": {
    "activities": [],
    "views": [],
    "commands": [],
    "piTools": [],
    "capabilities": [
      {
        "id": "devtools.files.hash",
        "title": "文件摘要校验",
        "description": "确认提供最多四项文件后计算两种摘要，可选输入一个预期摘要逐项比较；不修改原文件。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "expected": {
              "type": "string",
              "maxLength": 128,
              "title": "预期 SHA-256 或 SHA-512（可留空）"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "schemaVersion": {
                  "type": "integer",
                  "const": 2
                },
                "material": {
                  "type": "string",
                  "const": "file-integrity-report-list"
                },
                "files": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "properties": {
                      "index": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 33554432
                      },
                      "sha256": {
                        "type": "string",
                        "minLength": 64,
                        "maxLength": 64
                      },
                      "sha512": {
                        "type": "string",
                        "minLength": 128,
                        "maxLength": 128
                      },
                      "matches": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "index",
                      "bytes",
                      "sha256",
                      "sha512",
                      "matches"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "ok",
                "schemaVersion",
                "material",
                "files"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "boolean",
                  "const": false
                },
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "message": {
                      "type": "string",
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "ok",
                "error"
              ],
              "additionalProperties": false
            }
          ]
        },
        "maxResultBytes": 8192,
        "executionProfile": "resource.wasi.file-digest.v1",
        "resourceInputMin": 1,
        "resourceInputMax": 4,
        "resourceInputMimeTypes": [
          "application/json",
          "application/octet-stream",
          "image/png",
          "image/jpeg",
          "image/webp",
          "text/plain",
          "text/csv",
          "text/markdown",
          "text/html",
          "application/x-zicode-sqlite",
          "application/x-zicode-archive-zip",
          "application/x-zicode-archive-sevenzip",
          "application/x-zicode-archive-tar",
          "application/x-zicode-archive-targzip",
          "application/x-zicode-archive-tarzstd",
          "application/x-zicode-archive-tarxz",
          "application/x-zicode-archive-tarlzma",
          "application/x-zicode-archive-tarbzip2",
          "application/x-zicode-archive-tarlz4",
          "application/x-zicode-archive-gzip",
          "application/x-zicode-archive-zstandard",
          "application/x-zicode-archive-xz",
          "application/x-zicode-archive-lzma",
          "application/x-zicode-archive-lz4",
          "application/x-zicode-archive-brotli",
          "application/x-zicode-archive-rar",
          "application/x-zicode-archive-cab"
        ],
        "directory": {
          "categoryId": "files",
          "aliases": [
            "文件校验",
            "SHA256",
            "SHA512",
            "checksum"
          ],
          "description": "以快照方式读取经明确授权的文件。每次最多四项，总大小最多32 MiB；结果按选择顺序显示。"
        }
      }
    ]
  },
  "permissions": {
    "required": [
      {
        "name": "resource.read",
        "reason": "仅在逐次确认后读取所选文件快照，不修改原文件。"
      }
    ],
    "optional": []
  }
}
