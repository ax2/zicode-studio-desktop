              ],
              "additionalProperties": false
            }
          ]
        },
        "maxResultBytes": 2048,
        "directory": {
          "categoryId": "data",
          "aliases": [
            "工作日天数",
            "Count weekdays"
          ],
          "description": "按周一至周五计算天数，结束日包含在内。可选择包含开始日。"
        }
      },
      {
        "id": "devtools.date.workday_offset",
