{
  "schemaVersion": 2,
  "id": "com.zicode.devtools.clipboard-compose",
  "name": "ZiDevTools Clipboard Text Composition",
  "displayName": "剪贴片段组合",
  "description": "从确认的本机 JSON 组合有序正文，生成段落、编号、单列 CSV 或 Markdown 清单。",
  "version": "0.1.0",
  "publisher": "zicode",
  "license": "MIT",
  "engines": {
    "zicode": ">=0.7.2 <1.0.0",
    "pluginApi": "^1.0.0"
  },
  "requiredProfiles": {
    "resource.input.types.v1": "=1.0.0-preview.1",
    "resource.output.types.v1": "=1.0.0-preview.1",
    "tool.directory.v1": "=1.0.0-preview.1",
    "output.schema.v1": "=1.0.0-rc.1"
  },
  "activationEvents": [
    "onCapability:devtools.clipboard.text.compose"
  ],
  "runtime": {
    "wasi": "runtime/tools.wasm",
    "resourceInputProfile": "resource.wasi.input.draft2",
    "resourceOutputProfile": "resource.wasi.output.draft1"
  },
  "contributes": {
    "activities": [],
    "views": [],
    "commands": [],
    "piTools": [],
    "capabilities": [
      {
        "id": "devtools.clipboard.text.compose",
        "title": "剪贴片段组合",
        "description": "从确认的本机 JSON 组合有序正文，生成段落、编号、单列 CSV 或 Markdown 清单。",
        "resourceInputMimeTypes": [
          "application/json",
          "text/plain",
          "application/octet-stream"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "enum": [
                "paragraphs",
                "numbered",
                "csv",
                "markdown"
              ],
              "title": "结果格式",
              "description": "paragraphs 为段落，numbered 为编号，csv 为单列 CSV，markdown 为清单。"
            }
          },
          "required": [
            "format"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 64
                    },
                    "mimeType": {
                      "type": "string",
                      "enum": [
                        "text/plain",
                        "text/csv",
                        "text/markdown"
                      ]
                    },
                    "byteLength": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 49152
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 1024
                    }
                  },
                  "required": [
                    "count",
                    "mimeType",
                    "byteLength",
                    "text"
                  ],
                  "additionalProperties": false
                },
                "error": {
                  "type": "null"
                }
              },
              "required": [
                "ok",
                "data",
                "error"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "boolean",
                  "const": false
                },
                "data": {
                  "type": "null"
                },
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "message": {
                      "type": "string",
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "ok",
                "data",
                "error"
              ],
              "additionalProperties": false
            }
          ]
        },
        "maxResultBytes": 8192,
        "directory": {
          "categoryId": "files",
          "aliases": [
            "文本片段组合",
            "剪贴板 JSON 转列表",
            "Clipboard Text Composition"
          ],
          "description": "从确认的本机 JSON 组合有序正文，生成段落、编号、单列 CSV 或 Markdown 清单。"
        }
      }
    ]
  },
  "permissions": {
    "required": [
      {
        "name": "resource.read",
        "reason": "只读取本次明确确认的一份 JSON 正文集合。"
      }
    ],
    "optional": []
  }
}
