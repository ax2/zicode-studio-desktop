{
  "schemaVersion": 2,
  "id": "com.zicode.devtools.numeric-statistics",
  "name": "ZiDevTools Numeric Statistics",
  "displayName": "数值统计",
  "description": "离线计算总和、均值、中位数、总体和样本的方差及标准差。",
  "version": "0.1.0",
  "publisher": "zicode",
  "license": "MIT",
  "engines": {
    "zicode": ">=0.7.2 <1.0.0",
    "pluginApi": "^1.0.0"
  },
  "requiredProfiles": {
    "compute.wasi.v1": "=1.0.0-rc.1",
    "output.schema.v1": "=1.0.0-rc.1",
    "tool.directory.v1": "=1.0.0-preview.1"
  },
  "activationEvents": [
    "onCapability:devtools.statistics.sum",
    "onCapability:devtools.statistics.mean",
    "onCapability:devtools.statistics.median",
    "onCapability:devtools.statistics.population_variance",
    "onCapability:devtools.statistics.sample_variance",
    "onCapability:devtools.statistics.population_standard_deviation",
    "onCapability:devtools.statistics.sample_standard_deviation"
  ],
  "runtime": {
    "wasi": "runtime/tools.wasm"
  },
  "contributes": {
    "activities": [],
    "views": [],
    "commands": [],
    "piTools": [],
    "capabilities": [
      {
        "id": "devtools.statistics.sum",
        "title": "数值总和",
        "description": "把输入的实数相加。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "values": {
              "type": "string",
              "maxLength": 4096,
              "minLength": 1,
              "title": "数值",
              "description": "粘贴 1–64 个实数，用逗号、Tab 或换行分隔。最多 4096 UTF-8 字节，不跳过空值。"
            },
            "precision": {
              "type": "string",
              "enum": [
                "exact",
                "approximate"
              ],
              "default": "exact",
              "title": "计算精度",
              "description": "exact 使用精确有理数，支持分数如 1/3。approximate 使用有限小数或科学计数法。标准差始终标记为近似。"
            }
          },
          "required": [
            "values"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "contractVersion": {
                  "type": "string",
                  "const": "1.0.0-rc.1"
                },
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "error": {
                  "type": "null"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 64
                    },
                    "approximate": {
                      "type": "boolean"
                    },
                    "value": {
                      "type": "object",
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "exact"
                            },
                            "numerator": {
                              "type": "string",
                              "maxLength": 40
                            },
                            "denominator": {
                              "type": "string",
                              "maxLength": 39
                            }
                          },
                          "required": [
                            "kind",
                            "numerator",
                            "denominator"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "approx"
                            },
                            "value": {
                              "type": "string",
                              "maxLength": 64
                            }
                          },
                          "required": [
                            "kind",
                            "value"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 96
                    }
                  },
                  "required": [
                    "count",
                    "approximate",
                    "value",
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "contractVersion",
                "ok",
                "error",
                "data"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "contractVersion": {
                  "type": "string",
                  "const": "1.0.0-rc.1"
                },
                "ok": {
                  "type": "boolean",
                  "const": false
                },
                "data": {
                  "type": "null"
                },
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "maxLength": 32
                    },
                    "message": {
                      "type": "string",
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "contractVersion",
                "ok",
                "data",
                "error"
              ],
              "additionalProperties": false
            }
          ]
        },
        "maxResultBytes": 1024,
        "directory": {
          "categoryId": "data",
          "aliases": [
            "求和",
            "数列总和",
            "Numeric sum"
          ],
          "description": "把输入的实数相加。"
        }
      },
