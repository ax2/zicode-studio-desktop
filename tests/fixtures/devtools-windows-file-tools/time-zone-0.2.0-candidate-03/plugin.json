        "sourceToolId": "time-zone",
        "directory": {
          "categoryId": "data",
          "aliases": [
            "时区工作台",
            "时区转换",
            "timezone workbench"
          ],
          "description": "搜索来源与目的时区，换算并逐行复制。"
        }
      }
    ],
    "commands": [],
    "piTools": [],
    "capabilities": [
      {
        "id": "devtools.time-zone.convert",
        "title": "IANA 时间换算",
        "description": "用相同 IANA 时区规则离线将一个本地时间换算到最多 8 个时区，明确列出重复或缺失时间。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "localTime": {
              "type": "string",
              "maxLength": 32,
              "minLength": 1,
              "title": "本地时间",
              "description": "格式 YYYY-MM-DD HH:MM[:SS]，例如 2026-11-01 01:30。"
            },
            "sourceZone": {
              "type": "string",
              "maxLength": 64,
              "minLength": 1,
              "title": "来源时区",
              "description": "填 IANA 名称，例如 America/New_York。"
            },
            "targetZones": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "maxLength": 64,
                "minLength": 1
              },
              "title": "目的时区",
              "description": "按需要的顺序填写 JSON 数组，例如 [\"Asia/Shanghai\",\"Europe/London\"]。输入 1 至 8 个不同名称。"
            },
            "ambiguousChoice": {
              "type": "string",
              "enum": [
                "earlier",
                "later"
              ],
              "title": "重复时间选择（可选）",
              "description": "遇到重复时间先查看两个候选，再选 earlier（较早）或 later（较晚）。"
            }
          },
          "required": [
            "localTime",
            "sourceZone",
            "targetZones"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "contractVersion": {
                  "type": "string",
                  "const": "1.0.0-rc.1"
                },
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "unique",
                        "ambiguous",
                        "nonexistent"
                      ]
                    },
                    "sourceZone": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "sourceLocal": {
                      "type": "string",
                      "maxLength": 32
                    },
                    "sourceOffset": {
                      "oneOf": [
                        {
                          "type": "string",
                          "maxLength": 6
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "sourceAbbreviation": {
                      "oneOf": [
                        {
                          "type": "string",
                          "maxLength": 32
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "utc": {
                      "oneOf": [
                        {
                          "type": "string",
                          "maxLength": 40
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "earlier": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "utc": {
                              "type": "string",
                              "maxLength": 40
                            },
                            "offset": {
                              "type": "string",
                              "maxLength": 6
                            }
                          },
                          "required": [
                            "utc",
                            "offset"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "later": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "utc": {
                              "type": "string",
                              "maxLength": 40
                            },
                            "offset": {
                              "type": "string",
                              "maxLength": 6
                            }
                          },
                          "required": [
                            "utc",
                            "offset"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "selectedChoice": {
                      "oneOf": [
                        {
                          "type": "string",
                          "enum": [
                            "earlier",
                            "later"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "previousValid": {
                      "oneOf": [
                        {
                          "type": "string",
                          "maxLength": 32
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "nextValid": {
                      "oneOf": [
                        {
                          "type": "string",
                          "maxLength": 32
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "rows": {
                      "type": "array",
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "properties": {
                          "zone": {
                            "type": "string",
                            "maxLength": 64
                          },
                          "local": {
                            "type": "string",
                            "maxLength": 32
                          },
                          "offset": {
                            "type": "string",
                            "maxLength": 6
                          },
                          "abbreviation": {
                            "type": "string",
                            "maxLength": 32
                          }
                        },
                        "required": [
                          "zone",
                          "local",
                          "offset",
                          "abbreviation"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "tzdbVersion": {
                      "type": "string",
                      "const": "2025b"
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 2048
                    }
                  },
                  "required": [
                    "status",
                    "sourceZone",
                    "sourceLocal",
                    "sourceOffset",
                    "sourceAbbreviation",
                    "utc",
                    "earlier",
                    "later",
                    "selectedChoice",
                    "previousValid",
                    "nextValid",
                    "rows",
                    "tzdbVersion",
                    "text"
                  ],
                  "additionalProperties": false
                },
                "error": {
                  "type": "null"
                }
              },
              "required": [
                "contractVersion",
                "ok",
                "data",
                "error"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "contractVersion": {
                  "type": "string",
                  "const": "1.0.0-rc.1"
                },
                "ok": {
                  "type": "boolean",
                  "const": false
                },
                "data": {
                  "type": "null"
                },
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "maxLength": 32
                    },
                    "message": {
                      "type": "string",
