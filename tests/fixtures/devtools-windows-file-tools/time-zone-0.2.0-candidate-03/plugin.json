                }
              },
              "required": [
                "contractVersion",
                "ok",
                "data",
                "error"
              ],
              "additionalProperties": false
            }
          ]
        },
        "maxResultBytes": 4096,
        "directory": {
          "categoryId": "data",
          "aliases": [
