    "output.schema.v1": "=1.0.0-rc.1",
    "tool.directory.v1": "=1.0.0-preview.1",
    "tool.open.v1": "=1.0.0-preview.1",
    "view.operation.directory.v1": "=1.0.0-preview.1"
  },
