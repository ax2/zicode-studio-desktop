{
  "schemaVersion": 2,
  "id": "com.zicode.devtools.text",
  "name": "ZiDevTools Text",
  "displayName": "ZiDevTools 文本工具",
  "description": "Bounded local text utilities supplied as an independent WASI plugin.",
  "version": "0.4.1",
  "publisher": "zicode",
  "license": "MIT",
  "engines": {
    "zicode": ">=0.1.0 <1.0.0",
    "pluginApi": "^1.0.0"
  },
  "activationEvents": [
    "onView:devtools.text.main",
    "onCapability:devtools.text.json.format",
    "onCapability:devtools.text.json.minify",
    "onCapability:devtools.text.base64.encode",
    "onCapability:devtools.text.base64.decode",
    "onCapability:devtools.text.sha256",
    "onCapability:devtools.text.json.validate",
    "onCapability:devtools.text.sql.format"
  ],
  "runtime": {
    "wasi": "runtime/tools.wasm"
  },
  "contributes": {
    "activities": [
      {
        "id": "devtools.text",
        "title": "文本工具",
        "order": 850
      }
    ],
    "views": [
      {
        "id": "devtools.text.main",
        "activity": "devtools.text",
        "location": "main",
        "title": "文本工具",
        "entry": "views/main.html"
      }
    ],
    "capabilities": [
      {
        "id": "devtools.text.json.format",
        "title": "JSON 格式化",
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        "directory": {
          "categoryId": "data",
          "aliases": [
            "JSON formatter",
            "pretty print JSON",
            "JSON 格式化",
            "JSON 美化"
          ],
          "description": "Format supplied JSON text locally using the plugin's bounded compatibility rules."
        }
      },
      {
        "id": "devtools.text.json.minify",
        "title": "JSON 压缩",
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        "directory": {
          "categoryId": "data",
          "aliases": [
            "JSON minifier",
            "compact JSON",
            "JSON 压缩",
            "JSON 最小化"
          ],
          "description": "Remove insignificant whitespace from supplied JSON text locally using bounded compatibility rules."
        }
      },
      {
        "id": "devtools.text.json.validate",
        "title": "JSON 校验",
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        "directory": {
          "categoryId": "data",
          "aliases": [
            "JSON validator",
            "check JSON",
            "JSON 校验",
            "JSON 验证"
          ],
          "description": "Validate supplied JSON text against the plugin's duplicate-key, depth, and safe-integer restrictions."
        }
      },
      {
        "id": "devtools.text.base64.encode",
        "title": "Base64 编码",
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        "directory": {
          "categoryId": "data",
          "aliases": [
            "Base64 encoder",
            "encode Base64",
            "Base64 编码",
            "文本转 Base64"
          ],
          "description": "Encode supplied UTF-8 text as standard Base64 locally; no file input is read."
        }
      },
      {
        "id": "devtools.text.base64.decode",
        "title": "Base64 解码",
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        "directory": {
          "categoryId": "data",
          "aliases": [
            "Base64 decoder",
            "decode Base64",
            "Base64 解码",
            "Base64 转文本"
          ],
          "description": "Decode standard Base64 text locally and return UTF-8 text; no file input is read."
        }
      },
      {
        "id": "devtools.text.sha256",
        "title": "SHA-256",
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        "directory": {
          "categoryId": "security",
          "aliases": [
            "SHA-256 hash",
            "text checksum",
            "SHA-256 哈希",
            "文本摘要"
          ],
          "description": "Calculate SHA-256 for supplied UTF-8 text; this does not verify files or establish authenticity."
        }
      },
      {
        "id": "devtools.text.sql.format",
        "title": "SQL 格式化",
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        "directory": {
          "categoryId": "code",
          "aliases": [
            "SQL formatter",
            "format SQL query",
            "SQL 格式化",
            "SQL 美化"
          ],
          "description": "Format pasted SQL using the generic default dialect; does not connect to a database or validate semantics."
        }
      }
    ],
    "piTools": [
