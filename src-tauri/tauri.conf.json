{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZiCode Studio Desktop",
  "identifier": "com.zicode.studio.desktop",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../public",
    "beforeDevCommand": "bun run sync:vendor && bun run fetch:pi && bun run fetch:portable-git && bun run build:extensions && bun run bundle-css",
    "beforeBuildCommand": "bun run sync:vendor && bun run fetch:pi && bun run fetch:portable-git && bun run fetch:webview2 && bun run fetch:bun-runtime && bun run build:extensions && bun run build:react && bun run bundle-css"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' mediastream:; connect-src 'self' http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*;",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./entitlements.plist",
      "infoPlist": "./Info.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public": "public",
      "../extensions/dist": "extensions",
      "../NOTICE": "NOTICE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "./resources/pi": "pi",
      "./resources/portable-git": "portable-git",
      "./resources/webview2": "webview2",
      "./resources/bun": "bun"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2MDg5OUVDQUQxRTgwRkEKUldUNmdCNnQ3SmtJWnRpb2FhQkt3eG9TUThDOVQvTTN1dS9qd1hPRkI1TU42ZTJpdkNwUm1HdDIK",
      "endpoints": [
        "https://github.com/ax2/zicode-studio-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
