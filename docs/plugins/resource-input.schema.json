{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zicode:studio:resource-input:1.0.0-draft.5",
  "title": "Studio resource input request candidates (select operation definition)",
  "$defs": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeId", "sessionId", "pluginId", "capabilityId"],
      "properties": {
        "runtimeId": { "type": "string" },
        "sessionId": { "type": "string" },
        "pluginId": { "type": "string" },
        "capabilityId": { "type": "string" }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "owner", "resourceId", "contentVersion"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "owner": { "$ref": "#/$defs/owner" },
        "resourceId": { "type": "string", "format": "uuid" },
        "contentVersion": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "owner", "mimeType", "byteLength", "contentVersion"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "owner": { "$ref": "#/$defs/owner" },
        "mimeType": {
          "enum": [
            "application/octet-stream",
            "text/plain",
            "image/png",
            "image/jpeg",
            "image/webp",
            "application/x-zicode-archive-zip",
            "application/x-zicode-archive-sevenzip",
            "application/x-zicode-archive-tar",
            "application/x-zicode-archive-targzip",
            "application/x-zicode-archive-tarzstd",
            "application/x-zicode-archive-tarxz",
            "application/x-zicode-archive-tarlzma",
            "application/x-zicode-archive-tarbzip2",
            "application/x-zicode-archive-tarlz4",
            "application/x-zicode-archive-gzip",
            "application/x-zicode-archive-zstandard",
            "application/x-zicode-archive-xz",
            "application/x-zicode-archive-lzma",
            "application/x-zicode-archive-bzip2",
            "application/x-zicode-archive-lz4",
            "application/x-zicode-archive-brotli",
            "application/x-zicode-archive-rar",
            "application/x-zicode-archive-cab"
          ]
        },
        "byteLength": { "type": "integer", "minimum": 0, "maximum": 33554432 },
        "contentVersion": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "append": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access", "offset", "dataBase64"],
      "properties": {
        "access": { "$ref": "#/$defs/access" },
        "offset": { "type": "integer", "minimum": 0, "maximum": 33554432 },
        "dataBase64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 87384,
          "contentEncoding": "base64"
        }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access", "confirmed"],
      "properties": { "access": { "$ref": "#/$defs/access" }, "confirmed": { "const": true } }
    },
    "readView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access", "offset", "length"],
      "properties": {
        "access": { "$ref": "#/$defs/access" },
        "offset": { "type": "integer", "minimum": 0, "maximum": 33554432 },
        "length": { "type": "integer", "minimum": 1, "maximum": 32768 }
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access", "offset", "length"],
      "properties": {
        "access": { "$ref": "#/$defs/access" },
        "offset": { "type": "integer", "minimum": 0, "maximum": 33554432 },
        "length": { "type": "integer", "minimum": 1, "maximum": 65536 }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/prepare" },
    { "$ref": "#/$defs/append" },
    { "$ref": "#/$defs/commit" },
    { "$ref": "#/$defs/read" },
    { "$ref": "#/$defs/access" }
  ]
}
