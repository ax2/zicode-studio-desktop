  "date": "2026-10-11",
  "studioReviewDate": "2026-10-13",
  "schemaVersion": 1,
  "blockers": [
    {
      "id": "PROVIDER_PACKAGE",
      "reason": "No received versioned Studio plugin package, signed per-platform Worker or conformance vectors.",
      "owner": "ZiFile"
    },
    {
      "id": "HOST_NATIVE_RUNTIME",
      "reason": "Only JavaScript development Workers and WASI execution exist; confined native process runtime and per-platform lifecycle acceptance are missing.",
      "owner": "Studio"
    },
    {
      "id": "HOST_RESOURCE_MEDIATION",
      "reason": "Worker v3 accepts host paths and raw optional passwords; bounded WASI multi-file inputs and a one-level directory metadata Host candidate exist, but native private staging, short-lived password references, directory content grants, large archive streaming and write-time version checks remain missing.",
      "owner": "Studio and ZiFile"
    },
    {
      "id": "HOST_ARCHIVE_EVENTS",
      "reason": "Needs bounded versioned call-correlated streamed archive events, pagination, progress, terminal-state and cancellation guarantees.",
      "owner": "Studio and ZiFile"
    },
    {
      "id": "HOST_ARCHIVE_WRITE",
      "reason": "Needs prepare/commit target and conflict preview, operation-specific consent, atomic replacement, cancellation consistency and persistent recovery.",
      "owner": "Studio and ZiFile"
    },
    {
      "id": "PROVIDER_FORMAT_OPERATION",
      "reason": "Current supports_update excludes single-file streams, RAR and CAB; rename uses the same gate. Use explicit extract and recreate as a separate confirmed workflow where format capabilities allow.",
      "owner": "ZiFile"
    }
  ]
}
