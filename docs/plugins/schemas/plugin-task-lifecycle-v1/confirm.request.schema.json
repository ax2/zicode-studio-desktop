{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskRef", "operationStepId", "confirmationId", "decision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskRef": { "$ref": "common.schema.json#/$defs/taskRef" },
    "operationStepId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "confirmationId": { "$ref": "common.schema.json#/$defs/taskRef" },
    "decision": { "enum": ["approve", "decline"] }
  }
}
