{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "taskRef": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "operationId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*){1,8}$"
    },
    "idempotencyKey": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "awaiting_confirmation",
        "succeeded",
        "partial",
        "declined",
        "failed",
        "cancelled",
        "revoked",
        "interrupted"
      ]
    },
    "terminalState": {
      "enum": [
        "succeeded",
        "partial",
        "declined",
        "failed",
        "cancelled",
        "revoked",
        "interrupted"
      ]
    },
    "safeSummary": {
      "type": "string",
      "maxLength": 1024
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^task_[a-z0-9_]{1,64}$"
        },
        "message": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationStepId", "state"],
      "properties": {
        "operationStepId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "awaiting_confirmation",
            "succeeded",
            "declined",
            "failed",
            "cancelled",
            "revoked",
            "skipped"
          ]
        },
        "summary": {
          "$ref": "#/$defs/safeSummary"
        },
        "errorCode": {
          "type": "string",
          "pattern": "^task_[a-z0-9_]{1,64}$"
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "sequence", "finishedAt"],
      "properties": {
        "state": {
          "$ref": "#/$defs/terminalState"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "$ref": "#/$defs/safeSummary"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskRef",
        "operationId",
        "state",
        "latestSequence",
        "createdAt",
        "updatedAt",
        "steps"
      ],
      "properties": {
        "taskRef": {
          "$ref": "#/$defs/taskRef"
        },
        "operationId": {
          "$ref": "#/$defs/operationId"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "latestSequence": {
          "type": "integer",
          "minimum": 0
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "$ref": "#/$defs/safeSummary"
        },
        "steps": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "terminal": {
          "$ref": "#/$defs/terminal"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "type", "state", "occurredAt"],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": ["state_changed", "step_changed", "result_available", "terminal"]
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "operationStepId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "$ref": "#/$defs/safeSummary"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      }
    }
  }
}
