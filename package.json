{
  "name": "zicode-studio-desktop",
  "version": "0.5.3",
  "description": "Local-first cross-platform personal developer platform for projects, AI collaboration, knowledge, and automation",
  "keywords": [
    "zicode-studio-desktop",
    "zicode",
    "ai-workspace",
    "pi",
    "coding-agent",
    "developer-platform",
    "local-first",
    "desktop",
    "multi-agent",
    "tauri"
  ],
  "author": "Alex Xiang and contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ax2/zicode-studio-desktop.git"
  },
  "scripts": {
    "tauri": "tauri",
    "dev": "bun run scripts/dev-desktop.js",
    "sync:vendor": "bun run scripts/sync-vendor.js",
    "bundle-css": "node scripts/bundle-css.js",
    "update:pi:lock": "bun run scripts/update-pi-version.js --lock-only",
    "update:pi": "bun run scripts/update-pi-version.js",
    "fetch:pi": "bun run scripts/fetch-pi-binary.js",
    "fetch:portable-git": "bun run scripts/fetch-portable-git.js",
    "fetch:webview2": "bun run scripts/fetch-webview2.js",
    "fetch:bun-runtime": "bun run scripts/fetch-bun-runtime.js",
    "smoke:pi-rpc": "bun run scripts/smoke-pi-rpc.js",
    "smoke:pi-rpc:update": "bun run scripts/smoke-pi-rpc.js --update",
    "smoke:finance-extension": "bun run build:extensions && bun run scripts/smoke-finance-extension.js",
    "smoke:inbox-extension": "bun run build:extensions && bun run scripts/smoke-finance-extension.js --inbox",
    "smoke:plugins": "bun run scripts/smoke-plugin-writes.js",
    "build:extensions": "bun run scripts/build-extensions.js",
    "package:plugin": "bun run scripts/package-plugin.js",
    "verify:devtools-package": "bun run scripts/verify-devtools-package.mjs",
    "check:pi-sdk-alignment": "bun run scripts/check-pi-sdk-alignment.mjs",
    "check:plugin-manifest-profiles": "bun run scripts/check-plugin-manifest-profiles.mjs",
    "plugin:keygen": "bun run scripts/generate-plugin-key.js",
    "build": "bun run scripts/build-desktop.js",
    "build:local": "bun run scripts/build-desktop.js --local",
    "build:react": "node scripts/build-react.js",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "typecheck:external-clients": "tsc -p tsconfig.external-clients.json --noEmit",
    "typecheck:finance-core": "tsc -p tsconfig.finance-core.json --noEmit",
    "typecheck:chat-inbox-core": "tsc -p tsconfig.chat-inbox-core.json --noEmit",
    "typecheck:platform-core": "tsc -p tsconfig.platform-core.json --noEmit",
    "typecheck:extensions-source": "tsc -p tsconfig.extensions-source.json --noEmit",
    "release": "bash scripts/release.sh",
    "release:mac:dmg": "bash scripts/release-macos-dmg.sh",
    "test": "vitest run && bun run scripts/check-tauri-permissions.js && bun run scripts/check-windows-subprocesses.js && node scripts/check-i18n-coverage.mjs",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write . --unsafe",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome lint . && bun run check:design && bun run check:pi-sdk-alignment",
    "check:fix": "biome check --write . --unsafe --formatter-enabled=false --linter-enabled=false && bun run check:design:fix",
    "check:design": "bun scripts/check-design-css.mjs",
    "check:design:fix": "bun scripts/check-design-css.mjs --fix",
    "check:permissions": "bun run scripts/check-tauri-permissions.js",
    "check:windows-subprocesses": "bun run scripts/check-windows-subprocesses.js",
    "check:rust": "node scripts/check-rust.mjs",
    "check:rust:static": "node scripts/check-rust.mjs --static-only",
    "check:platform": "node scripts/developer-platform-checks.mjs",
    "qa:console": "node scripts/qa-console-errors.mjs",
    "qa:keyboard": "node scripts/qa-keyboard.mjs",
    "qa:locale": "node scripts/qa-locale.mjs",
    "qa:full": "node scripts/qa-full.mjs",
    "qa:data": "node scripts/qa-data-presence.mjs",
    "qa:a11y": "node scripts/qa-a11y.mjs",
    "qa:blog": "node scripts/qa-blog-output.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "chart.js": "4.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remend": "^1.3.0",
    "semver": "7.8.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@sinclair/typebox": "^0.34.52",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "7.8.0",
    "esbuild": "0.28.0",
    "fflate": "0.8.2",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
