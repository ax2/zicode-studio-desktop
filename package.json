{
  "name": "zicode-studio-desktop",
  "version": "0.1.0",
  "description": "Self-contained multi-scene AI desktop workspace powered by Pi and Tauri",
  "keywords": [
    "zicode-studio-desktop",
    "zicode",
    "ai-workspace",
    "pi",
    "coding-agent",
    "desktop",
    "multi-agent",
    "tauri"
  ],
  "author": "Alex Xiang and contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ax2/zicode-studio-desktop.git"
  },
  "scripts": {
    "tauri": "tauri",
    "dev": "bun run fetch:pi && bun run fetch:portable-git && PATH=\"$HOME/.cargo/bin:$PATH\" tauri dev",
    "fetch:pi": "bun run scripts/fetch-pi-binary.js",
    "fetch:portable-git": "bun run scripts/fetch-portable-git.js",
    "fetch:webview2": "bun run scripts/fetch-webview2.js",
    "smoke:pi-rpc": "bun run scripts/smoke-pi-rpc.js",
    "build:extensions": "bun run scripts/build-extensions.js",
    "build": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build",
    "prebuild": "bun run fetch:pi && bun run fetch:portable-git && bun run fetch:webview2 && bun run build:extensions",
    "release": "bash scripts/release.sh",
    "release:mac:dmg": "bash scripts/release-macos-dmg.sh",
    "test": "vitest run && bun run scripts/check-tauri-permissions.js && bun run scripts/check-windows-subprocesses.js",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write . --unsafe",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome lint . && bun run check:design",
    "check:fix": "biome check --write . --unsafe --formatter-enabled=false --linter-enabled=false && bun run check:design:fix",
    "check:design": "bun scripts/check-design-css.mjs",
    "check:design:fix": "bun scripts/check-design-css.mjs --fix",
    "check:permissions": "bun run scripts/check-tauri-permissions.js",
    "check:windows-subprocesses": "bun run scripts/check-windows-subprocesses.js",
    "check:rust": "bash scripts/check-rust.sh"
  },
  "dependencies": {
    "remend": "^1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@tauri-apps/cli": "^2.11.2",
    "esbuild": "^0.28.0",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}
